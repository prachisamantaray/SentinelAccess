# Copy this file to .env and fill in real values before running the app.

# Flask session signing key - set this to a long random string in any real deployment.
SECRET_KEY=change-this-to-a-random-secret-string

# Path to the Firebase service account key JSON file (see README for how to get one).
FIREBASE_CRED_PATH=serviceAccountKey.json

# Optional: ipinfo.io API token for real IP geolocation. Leave blank to use
# deterministic mock geolocation data instead (fine for local testing/demo).
IPINFO_TOKEN=
